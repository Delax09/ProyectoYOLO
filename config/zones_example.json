# Ejemplo de zonas restringidas en JSON
# Cada zona es un polígono definido por coordenadas (x, y)

{
  "zones": [
    {
      "id": "zona_entrada",
      "name": "Zona de Entrada",
      "enabled": true,
      "dwell_threshold_sec": 3.0,
      "coordinates": [
        [100, 100],
        [500, 100],
        [500, 400],
        [100, 400]
      ]
    },
    {
      "id": "zona_deposito",
      "name": "Zona Depósito",
      "enabled": true,
      "dwell_threshold_sec": 5.0,
      "coordinates": [
        [600, 150],
        [900, 150],
        [900, 500],
        [600, 500]
      ]
    }
  ]
}
